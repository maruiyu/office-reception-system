# バックエンド環境変数サンプル
# .env にリネームして実際の値を入力してください

PORT=4000

# Supabase（https://supabase.com でプロジェクト作成後に取得）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sesame API（CANDY HOUSE管理画面から取得）
SESAME_API_KEY=your_sesame_api_key_here
SESAME_DEVICE_ID=your_sesame_device_uuid_here

# Web Push VAPID鍵（npx web-push generate-vapid-keys で生成）
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@example.com

# フロントエンドのURL（CORS設定用）
FRONTEND_URL=http://localhost:3000
